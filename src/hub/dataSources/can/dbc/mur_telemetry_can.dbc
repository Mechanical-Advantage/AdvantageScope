 SG_ PDU_PumpTripped : 4|1@1+ (1,0) [0|1] "" TELEMETRY,ECU
 SG_ PDU_Fan1Tripped : 5|1@1+ (1,0) [0|1] "" TELEMETRY,ECU
 SG_ PDU_Fan2Tripped : 6|1@1+ (1,0) [0|1] "" TELEMETRY,ECU
 SG_ PDU_HighCurrentTripped : 7|1@1+ (1,0) [0|1] "" TELEMETRY,ECU
 SG_ PDU_BatteryRefVoltage : 8|16@1+ (0.01,0) [0|655.35] "V" TELEMETRY,ECU

BO_ 529 PDU_Control: 4 ECU
 SG_ PDU_CMD_PumpState : 0|1@1+ (1,0) [0|1] "" PDU,TELEMETRY
 SG_ PDU_CMD_HighCurrentState : 1|1@1+ (1,0) [0|1] "" PDU,TELEMETRY
 SG_ PDU_CMD_Fan1Duty : 8|8@1+ (1,0) [0|100] "%" PDU,TELEMETRY
