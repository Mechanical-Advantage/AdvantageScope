 SG_ PDU_HighCurrentState : 1|1@1+ (1,0) [0|1] "" TELEMETRY,ECU
 SG_ PDU_Fan1Duty : 8|8@1+ (1,0) [0|100] "%" TELEMETRY,ECU
 SG_ PDU_Fan2Duty : 16|8@1+ (1,0) [0|100] "%" TELEMETRY,ECU
 SG_ PDU_PumpCurrent : 24|8@1+ (0.1,0) [0|25.5] "A" TELEMETRY,ECU
 SG_ PDU_Fan1Current : 32|8@1+ (0.1,0) [0|25.5] "A" TELEMETRY,ECU
 SG_ PDU_Fan2Current : 40|8@1+ (0.1,0) [0|25.5] "A" TELEMETRY,ECU
 SG_ PDU_HighCurrentCurrent : 48|8@1+ (0.1,0) [0|25.5] "A" TELEMETRY,ECU
 SG_ PDU_HeartbeatCounter : 56|8@1+ (1,0) [0|255] "" TELEMETRY

