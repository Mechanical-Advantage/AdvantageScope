 SG_ DASH_WheelSpeedFL : 0|16@1+ (0.1,0) [0|6553.4] "rpm" TELEMETRY
 SG_ DASH_WheelSpeedFR : 16|16@1+ (0.1,0) [0|6553.4] "rpm" TELEMETRY
 SG_ DASH_WheelFreqFL : 32|12@1+ (1,0) [0|4095] "Hz" TELEMETRY
 SG_ DASH_WheelFreqFR : 44|12@1+ (1,0) [0|4095] "Hz" TELEMETRY
 SG_ DASH_WheelCounter : 56|8@1+ (1,0) [0|255] "" TELEMETRY

BO_ 516 Dashboard_Speed: 6 DASH
 SG_ DASH_SpeedFL : 0|16@1+ (0.1,0) [0|6553.4] "km/h" TELEMETRY
