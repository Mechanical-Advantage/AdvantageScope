{
  "name": "mur-voir",
  "productName": "mur-voir",
  "version": "27.0.0-alpha-6",
  "description": "Telemetry dashboard for Melbourne Uni Motorsport (based on AdvantageScope)",
  "author": {
    "name": "Melbourne University Motorsports",
    "url": "https://github.com/Melbourne-University-Motorsports/mur-voir"
  },
  "license": "BSD-3-Clause",
  "main": "bundles/main.js",
  "scripts": {
    "start": "electron bundles/main.js",
    "compile": "rolldown -c",
    "typecheck": "tsc --noEmit --skipLibCheck -p .",
    "build": "npm run compile && npm run wasm:compile && electron-builder build",
    "build-linux": "npm run compile && npm run wasm:compile && electron-builder build -c.electronVersion=37.10.3",
    "fast-build": "npm run compile && npm run wasm:compile && electron-builder build --dir",
    "watch": "rolldown -c -w",
    "format": "license-check-and-add add -f file-header-config.json -r \"2026 Melbourne University Motorsports. Based on AdvantageScope (BSD-3-Clause, © Littleton Robotics).\" \"https://github.com/Melbourne-University-Motorsports/mur-voir\" && prettier --write .",
    "check-format": "license-check-and-add check -f file-header-config.json && prettier --check .",
    "wasm:compile": "node wasmCompile.mjs",
    "mock-backend": "node tools/mock-backend/src/main.ts",
    "postinstall": "node installElectron.mjs && node getLicenses.mjs && node bundleLiteAssets.mjs",
    "test": "node tools/run-tests.mjs",
    "mqtt-mock": "node tools/mqtt-mock/main.mjs"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.26.0",
    "@electron/notarize": "^2.1.0",
    "@foxglove/rosmsg": "^5.0.5",
    "@foxglove/rosmsg2-serialization": "^3.1.2",
    "@foxglove/ws-protocol": "^0.8.0",
    "@mcap/core": "^1.3.0",
    "@msgpack/msgpack": "^3.0.0-beta2",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-typescript": "12.1.1",
    "@types/chart.js": "^2.9.38",
    "@types/color-convert": "^2.0.3",
    "@types/compare-versions": "^3.3.0",
    "@types/download": "^8.0.2",
    "@types/heatmap.js": "2.0.38",
    "@types/jsonfile": "^6.1.2",
    "@types/lzma-native": "^4.0.4",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.168.0",
    "@types/ws": "^8.18.2",
    "ansi_up": "^6.0.6",
    "bignumber.js": "^9.1.2",
    "buffer": "^6.0.3",
    "camera-controls": "^2.9.0",
    "chart.js": "^4.4.0",
    "color-convert": "^2.0.1",
    "compare-versions": "^6.1.1",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "fuse.js": "^7.0.0",
    "fzstd": "^0.1.1",
    "gunzip-file": "^0.1.1",
    "heatmap.js": "github:jwbonner/heatmap.js#24b4455c95f5e54cb50ab8bb06f9229d30426362",
    "license-check-and-add": "^4.0.5",
    "mathjs": "11.3.0",
    "prettier": "3.0.3",
    "prettier-plugin-organize-imports": "^4.0.0",
    "protobufjs": "^8.3.0",
    "rolldown": "1.0.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "simple-statistics": "^7.8.7",
    "three": "^0.168.0",
    "tiny-popup-menu": "^1.0.10",
    "tslib": "^2.6.2",
    "type-fest": "^4.26.1",
    "typescript": "5.6.3",
    "ws": "^8.22.0",
    "xz-decompress": "^0.2.3"
  },
  "dependencies": {
    "@types/emscripten": "^1.39.13",
    "aedes": "^1.2.0",
    "check-disk-space": "^3.4.0",
    "download": "^8.0.0",
    "jsonfile": "^6.1.0",
    "lzma-native": "^8.0.6",
    "mqtt": "^5.16.1",
    "pngjs": "^7.0.0",
    "websocket-stream": "^5.5.2"
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "build": {
    "appId": "io.github.melbourne-university-motorsports.mur-voir",
    "copyright": "Copyright © 2026 Melbourne University Motorsports. Based on AdvantageScope, © 2021-2026 Littleton Robotics.",
    "npmRebuild": false,
    "publish": [],
    "electronFuses": {
      "runAsNode": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "www/**/*",
      "bundles/**/*",
      "icons/**/*.png",
      "!icons/**/*.iconset",
      "bundledAssets/**/*",
      "!**/.*"
    ],
    "extraResources": [
      "LICENSE",
      "ThirdPartyLicenses.txt"
    ],
    "fileAssociations": [
      {
        "ext": "wpilog",
        "name": "WPILib robot log",
        "description": "WPILib robot log",
        "mimeType": "application/x-wpilog",
        "role": "Viewer",
        "icon": "icons/app/wpilog-icon"
      },
      {
        "ext": "wpilogxz",
        "name": "Compressed WPILib robot log",
        "description": "Compressed WPILib robot log",
        "mimeType": "application/x-wpilogxz",
        "role": "Viewer",
        "icon": "icons/app/wpilogxz-icon"
      },
      {
        "ext": "rlog",
        "name": "Robot log",
        "description": "Robot log",
        "mimeType": "application/x-rlog",
        "role": "Viewer",
        "icon": "icons/app/rlog-icon"
      },
      {
        "ext": "csv",
        "name": "Comma-separated values",
        "description": "Comma-separated values",
        "mimeType": "text/csv",
        "role": "Viewer"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "icons/app/app-icon.icns",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "CFBundleLocalizations": [
          "en"
        ],
        "NSLocalNetworkUsageDescription": "mur-voir uses the local network to receive live telemetry."
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "snap",
        "flatpak",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "icons/app/app-icons-linux",
      "category": "Utility"
    },
    "flatpak": {
      "runtimeVersion": "22.08",
      "baseVersion": "22.08"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/app/app-icon.ico"
    }
  },
  "allowScripts": {
    "electron": true,
    "lzma-native": true,
    "protobufjs": true,
    "electron-winstaller": false
  }
}
