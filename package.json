{
  "name": "advantagescope",
  "productName": "AdvantageScope",
  "desktopName": "advantagescope.desktop",
  "version": "27.0.0-beta-1",
  "description": "Robot telemetry application",
  "author": {
    "name": "Littleton Robotics",
    "email": "software@littletonrobotics.org",
    "url": "https://littletonrobotics.org"
  },
  "license": "BSD-3-Clause",
  "main": "bundles/main.js",
  "scripts": {
    "start": "electron bundles/main.js",
    "compile": "rolldown -c",
    "build": "npm run compile && npm run wasm:compile && npm run docs:build-embed && electron-builder build",
    "fast-build": "npm run compile && npm run wasm:compile && npm run docs:build-embed && electron-builder build --dir",
    "watch": "rolldown -c -w",
    "download-owlet": "rolldown -c --configRunOwletDownload && node runOwletDownload.js",
    "format": "license-check-and-add add -f file-header-config.json && prettier --write .",
    "check-format": "license-check-and-add check -f file-header-config.json && prettier --check .",
    "wasm:compile": "node wasmCompile.mjs",
    "docs:start": "npm --prefix docs run start",
    "docs:build": "npm --prefix docs run build",
    "docs:build-embed": "npm --prefix docs run build-embed",
    "docs:clear": "npm --prefix docs run clear",
    "docs:serve": "npm --prefix docs run serve",
    "postinstall": "npm --prefix docs install && node getLicenses.mjs && node tesseractLangDownload.mjs && node bundleLiteAssets.mjs && npm run download-owlet"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.14",
    "@mcap/core": "^1.3.0",
    "@msgpack/msgpack": "^3.1.3",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-typescript": "12.1.1",
    "@types/color-convert": "^2.0.4",
    "@types/emscripten": "^1.41.6",
    "@types/heatmap.js": "2.0.38",
    "@types/jsonfile": "^6.1.4",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.168.0",
    "@types/ws": "^8.18.2",
    "adm-zip": "^0.6.1",
    "ansi_up": "^6.0.6",
    "bignumber.js": "^9.3.1",
    "buffer": "^6.0.3",
    "camera-controls": "^2.10.1",
    "chart.js": "^4.6.2",
    "color-convert": "^2.0.1",
    "compare-versions": "^6.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "fuse.js": "^7.5.0",
    "heatmap.js": "github:jwbonner/heatmap.js#24b4455c95f5e54cb50ab8bb06f9229d30426362",
    "license-check-and-add": "^4.0.5",
    "mathjs": "11.3.0",
    "prettier": "3.0.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "protobufjs": "^8.8.1",
    "qr-code-styling": "^1.9.2",
    "rolldown": "1.0.2",
    "rollup-plugin-cleanup": "^3.2.1",
    "simple-statistics": "^7.12.1",
    "three": "^0.168.0",
    "tiny-popup-menu": "^1.0.15",
    "tslib": "^2.9.1",
    "type-fest": "^4.41.0",
    "typescript": "5.6.3",
    "xz-decompress": "^0.2.3"
  },
  "dependencies": {
    "@napi-rs/lzma": "^1.5.3",
    "@rev-robotics/revlog-converter": "^2.0.0",
    "check-disk-space": "^3.4.0",
    "jsonfile": "^6.2.1",
    "ssh2": "^1.17.0",
    "tesseract.js": "^6.0.0",
    "ws": "^8.23.0",
    "youtube-dl-exec": "github:jwbonner/youtube-dl-exec#cf57cd14eb1d1865e7d329c36ccc291a5ae9ec52"
  },
  "allowScripts": {
    "github:jwbonner/youtube-dl-exec#cf57cd14eb1d1865e7d329c36ccc291a5ae9ec52": true,
    "cpu-features": false,
    "electron-winstaller": false,
    "protobufjs": false,
    "ssh2": false,
    "tesseract.js": false
  },
  "prettier": {
    "printWidth": 120,
    "trailingComma": "none",
    "plugins": [
      "prettier-plugin-organize-imports"
    ]
  },
  "build": {
    "appId": "org.littletonrobotics.advantagescope",
    "copyright": "Copyright © 2021-2026 Littleton Robotics",
    "npmRebuild": false,
    "publish": [],
    "electronFuses": {
      "runAsNode": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "www/**/*",
      "bundles/**/*",
      "icons/**/*.png",
      "!icons/**/*.iconset",
      "bundledAssets/**/*",
      "docs/build/**/*",
      {
        "filter": [
          "owlet/${os}-${arch}/*"
        ]
      },
      "@rev-robotics/revlog-converter/**/*",
      "!**/.*"
    ],
    "extraResources": [
      "LICENSE",
      "ThirdPartyLicenses.txt",
      "eng.traineddata.gz"
    ],
    "fileAssociations": [
      {
        "ext": "wpilog",
        "name": "WPILib robot log",
        "description": "WPILib robot log",
        "mimeType": "application/x-wpilog",
        "role": "Viewer",
        "icon": "icons/app/wpilog-icon"
      },
      {
        "ext": "wpilogxz",
        "name": "Compressed WPILib robot log",
        "description": "Compressed WPILib robot log",
        "mimeType": "application/x-wpilogxz",
        "role": "Viewer",
        "icon": "icons/app/wpilogxz-icon"
      },
      {
        "ext": "rlog",
        "name": "Robot log",
        "description": "Robot log",
        "mimeType": "application/x-rlog",
        "role": "Viewer",
        "icon": "icons/app/rlog-icon"
      },
      {
        "ext": "hoot",
        "name": "Hoot robot log",
        "description": "Hoot robot log",
        "mimeType": "application/x-hoot",
        "role": "Viewer",
        "icon": "icons/app/hoot-icon"
      },
      {
        "ext": "revlog",
        "name": "REV Robotics CAN log",
        "description": "REV Robotics CAN log",
        "mimeType": "application/x-revlog",
        "role": "Viewer",
        "icon": "icons/app/revlog-icon"
      },
      {
        "ext": "csv",
        "name": "Comma-separated values",
        "description": "Comma-separated values",
        "mimeType": "text/csv",
        "role": "Viewer"
      },
      {
        "ext": "dslog",
        "name": "NI Driver Station log",
        "description": "NI Driver Station log",
        "mimeType": "application/x-dslog",
        "role": "Viewer",
        "icon": "icons/app/dslog-icon"
      },
      {
        "ext": "dsevents",
        "name": "NI Driver Station events",
        "description": "NI Driver Station events",
        "mimeType": "application/x-dsevents",
        "role": "Viewer",
        "icon": "icons/app/dsevents-icon"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "icons/app/app-icon.icon",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "CFBundleLocalizations": [
          "en"
        ],
        "NSLocalNetworkUsageDescription": "AdvantageScope uses the local network to communicate with robots.",
        "NSUpdateSecurityPolicy": {
          "AllowPackages": [
            "8L3DF24D82"
          ],
          "AllowProcesses": {
            "8L3DF24D82": [
              "WPILibInstaller"
            ]
          }
        }
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "snap",
        "flatpak",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "icons/app/app-icons-linux",
      "category": "Utility",
      "syncDesktopName": true
    },
    "flatpak": {
      "runtimeVersion": "26.08",
      "baseVersion": "26.08"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/app/app-icon.ico"
    }
  }
}
